# KMJ TIPS — environment variables
# Copy to .env (never commit real secrets)

# Port the panel + API listen on
PORT=3000

# REQUIRED — min 32 random chars. Signs admin JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# How long admin sessions last (e.g. 12h, 7d)
JWT_EXPIRES=12h

# SQLite file location (default: ./kmj-tips.db next to server.js)
DB_PATH=./kmj-tips-data.json

# Set to 1 when running behind a reverse proxy / Render / Vercel
# so rate-limiting sees the real client IP
TRUST_PROXY=0
